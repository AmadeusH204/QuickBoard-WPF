<Window x:Class="QuickBoard.Views.EditEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑条目" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

  <Border Margin="14" CornerRadius="12" Background="{DynamicResource BgBrush}"
          BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#FF000000" />
    </Border.Effect>

    <StackPanel Margin="20,16,20,14">
      <TextBlock Text="编辑条目" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14" />

      <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
      <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" />

      <TextBlock Text="目标（程序、快捷方式、文件或文件夹）" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="TargetBox" Style="{StaticResource FieldBox}" />
        <Button Grid.Column="1" Content="浏览" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="BrowseTarget_Click" />
      </Grid>

      <TextBlock Text="参数" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
      <TextBox x:Name="ArgumentsBox" Style="{StaticResource FieldBox}" />

      <TextBlock Text="起始目录" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="WorkingDirBox" Style="{StaticResource FieldBox}" />
        <Button Grid.Column="1" Content="浏览" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="BrowseWorkingDir_Click" />
      </Grid>

      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="110" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="键位（Q W E … /，留空不绑定）" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="SlotBox" Style="{StaticResource FieldBox}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="收藏键" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="FavBox" Style="{StaticResource FieldBox}" ToolTip="F1–F12，留空表示不在收藏栏" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="启动后摆放" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="PlacementBox" Style="{StaticResource FieldBox}" ToolTip="留空、LeftHalf、RightHalf、Center" />
        </StackPanel>
      </Grid>

      <CheckBox x:Name="AdminCheck" Content="以管理员身份运行" Margin="0,14,0,0" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="16,6" Click="Cancel_Click" />
        <Button Content="保存" Style="{StaticResource PillButton}" Padding="18,6" Margin="8,0,0,0" Click="Save_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
