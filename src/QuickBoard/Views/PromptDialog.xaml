<Window x:Class="QuickBoard.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

  <Border Margin="14" CornerRadius="12" Background="{DynamicResource BgBrush}"
          BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#FF000000" />
    </Border.Effect>

    <StackPanel Margin="20,16,20,14">
      <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />
      <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabel}" />
      <TextBox x:Name="ValueBox" Style="{StaticResource FieldBox}" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="16,6" Click="Cancel_Click" />
        <Button Content="确定" Style="{StaticResource PillButton}" Padding="18,6" Margin="8,0,0,0"
                Click="Ok_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
