<Window x:Class="QuickBoard.Views.GroupEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分组编辑" Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

  <Border Margin="14" CornerRadius="12" Background="{DynamicResource BgBrush}"
          BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#FF000000" />
    </Border.Effect>

    <StackPanel Margin="20,16,20,14">
      <TextBlock Text="分组编辑" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5" />
      <TextBlock FontSize="11" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                 Text="在这里新增/删除分组、隐藏不常用的分组，或指定启动时的主界面分组（带 ★ 标记）。" />

      <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="GroupList" HorizontalContentAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                      Background="#14FFFFFF" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding NoText}" FontSize="12"
                             Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           Margin="0,0,8,0" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                             Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />

                  <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                              Margin="0,7,0,0" VerticalAlignment="Center">
                    <Button Content="{Binding HomeButtonText}" Style="{StaticResource GhostButton}"
                            Padding="9,4" FontSize="11" Click="SetHome_Click" Tag="{Binding}"
                            IsEnabled="{Binding CanSetHome}" />
                    <CheckBox Content="隐藏" FontSize="11" Margin="10,0,0,0"
                              IsChecked="{Binding IsHidden, Mode=OneWay}"
                              Click="HideToggle_Click" Tag="{Binding}" />
                    <Button Content="↑" Style="{StaticResource GhostButton}" Padding="9,4" FontSize="12"
                            ToolTip="上移" Click="MoveUp_Click" Tag="{Binding}" />
                    <Button Content="↓" Style="{StaticResource GhostButton}" Padding="9,4" FontSize="12"
                            ToolTip="下移" Click="MoveDown_Click" Tag="{Binding}" />
                    <Button Content="删除" Style="{StaticResource GhostButton}" Padding="9,4" FontSize="11"
                            Foreground="#FFFF9A9A" Click="DeleteGroup_Click" Tag="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border CornerRadius="6" Background="#10FFFFFF" Padding="10,7" Margin="0,2,0,0">
        <TextBlock FontSize="11" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap"
                   Text="收藏栏（F1–F12）固定置顶显示，不属于普通分组，不能隐藏或删除。" />
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="＋ 新增分组" Style="{StaticResource GhostButton}" Padding="12,6"
                HorizontalAlignment="Left" Margin="0,0,120,0" Click="AddGroup_Click" />
        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="16,6" Click="Cancel_Click" />
        <Button Content="完成" Style="{StaticResource PillButton}" Padding="18,6" Margin="8,0,0,0"
                Click="Done_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
