<Window x:Class="QuickBoard.Views.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置热键" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

  <Border Margin="14" CornerRadius="12" Background="{DynamicResource BgBrush}"
          BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#FF000000" />
    </Border.Effect>

    <StackPanel Margin="20,16,20,14">
      <TextBlock Text="设置唤起热键" FontSize="13" FontWeight="SemiBold" />
      <TextBlock Text="请直接按下想要的组合键（需包含 Ctrl / Alt / Win 之一）"
                 FontSize="11" Foreground="{DynamicResource DimBrush}" Margin="0,4,0,12" />

      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Height="56" BorderThickness="1"
              BorderBrush="{DynamicResource LineBrush}">
        <TextBlock x:Name="KeyText" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="16,6" Click="Cancel_Click" />
        <Button Content="确定" Style="{StaticResource PillButton}" Padding="18,6" Margin="8,0,0,0" Click="Ok_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
